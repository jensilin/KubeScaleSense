# syntax=docker/dockerfile:1

# The demonstration workload. Built from the same module as the controller but
# shipped as its own image, because it is a separate program: the workload must
# be replaceable without rebuilding the controller, and vice versa.

# --- build stage ----------------------------------------------------------
FROM golang:1.27-alpine AS build

ARG VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/normalizer ./cmd/normalizer

# --- runtime stage --------------------------------------------------------
FROM gcr.io/distroless/static:nonroot

USER 65532:65532

WORKDIR /

COPY --from=build /out/normalizer /usr/local/bin/normalizer

# Everything is configured through NORMALIZER_* environment variables, supplied
# by the ConfigMap in deploy/normalizer/. Nothing is baked in, so retuning the
# workload for a scenario does not require a rebuild.
ENTRYPOINT ["/usr/local/bin/normalizer"]
