        "identifier": "44444444-4444-4444-8444-444444444444",
        "instanceIdentifier": "44444444-4444-4444-8444-444444444444",
        "name": "InvokeHTTP - normalize",
        "comments": "The client of the scaling target. Three settings here are the flow's reason for existing as a reviewed artifact rather than a screenshot: concurrentlySchedulableTaskCount is 16, above any sane maxReplicas, or scaling adds replicas that nothing dispatches to (A-13, FS-28); Retry and Failure are retried relationships with bounded backoff, which is the entire durability guarantee of the v0.2 design (D-02); and the read timeout is 60s, comfortably above the Normalizer's queue timeout plus processing time, or every slow record is retried while still in flight (FS-29). 'No Retry' is deliberately NOT retried: a 400 means the record is malformed, and retrying it forever is a poison pill that spends the pool's capacity on a record that can never succeed.",
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.6.7"
        },
        "properties": {
          "HTTP Method": "POST",
          "HTTP URL": "http://normalizer-service.data-pipeline.svc/normalize",
          "Request Content-Type": "text/plain",
          "Request Body Enabled": "true",
          "Response Body Ignored": "false",
          "Response Generation Required": "true",
          "Socket Connect Timeout": "5 secs",
          "Socket Read Timeout": "60 secs",
          "Socket Idle Timeout": "5 mins",
          "Penalize on \"No Retry\"": "false",
          "Response Redirects Enabled": "false"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
